VLLM_API_KEY=EMPTY
VLLM_MODEL_NAME=Qwen/Qwen3.5-122B-A10B
VLLM_ENABLE_THINKING=false

# Or use a model name directly:
# activate_model_name=Qwen/Qwen3.5-122B-A10B

LEGAL_GRAPH_NAME=legal_graph
LEGAL_EMBED_DIM=384

